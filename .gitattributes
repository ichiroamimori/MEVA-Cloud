* text=auto

# Cross-platform source and configuration files use LF in the working tree.
*.py text eol=lf
*.json text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.mjcf text eol=lf
*.urdf text eol=lf
*.obj text eol=lf
*.mtl text eol=lf

# Robot meshes and generated numerical artifacts are byte-for-byte binary.
*.stl -text
*.bin -text
*.npz -text
*.pkl -text

# Windows launch scripts retain native line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
